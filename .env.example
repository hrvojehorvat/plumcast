# Copy to .env.local (gitignored) and fill in your own provider login. Never commit .env.local.
# Used only in development: by the browser dev proxy (npm run proxy) and to prefill the login form.
EXPO_PUBLIC_DEV_XTREAM_URL=http://example.com:8080
EXPO_PUBLIC_DEV_XTREAM_USER=
EXPO_PUBLIC_DEV_XTREAM_PASS=
# Port of the local proxy (default 8787).
PLUMCAST_PROXY_PORT=8787
